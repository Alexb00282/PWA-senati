{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "app-assets",
      "installMode": "prefetch",
      "resources": {
        "files": ["/manifest.webmanifest", "/assets/icons/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "tareas-api",
      "urls": ["/assets/data/tareas.json"],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "1d",
        "maxSize": 50,
        "timeout": "5s"
      }
    }
  ]
}
